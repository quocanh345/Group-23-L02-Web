# Cổng HTTP mà backend lắng nghe
PORT=3000
# Môi trường chạy: development | production
NODE_ENV=development
# Địa chỉ frontend được phép gọi API (CORS), mặc định là Vite dev server
CORS_ORIGIN=http://localhost:5173
# API key của nhà cung cấp AI. Để trống ở đây, chỉ điền vào file .env trên máy mình
AI_API_KEY=
