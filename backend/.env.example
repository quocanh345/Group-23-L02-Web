# Chuỗi kết nối PostgreSQL cho Prisma. Khớp với giá trị mặc định trong docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_app?schema=public"
# Cổng HTTP mà backend lắng nghe
PORT=3000
# Môi trường chạy: development | production
NODE_ENV=development
# Địa chỉ frontend được phép gọi API (CORS), mặc định là Vite dev server
CORS_ORIGIN=http://localhost:5173
# API key của nhà cung cấp AI. Để trống ở đây, chỉ điền vào file .env trên máy mình
AI_API_KEY=

# Khóa bí mật dùng để ký và xác minh JWT
JWT_SECRET=
# Thời gian sống của Access Token
JWT_EXPIRES_IN=7d